<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>VideoSeeker</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredPGO>true</TieredPGO>
    <ApplicationIcon>Assets\VideoSeeker.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Hashing" Version="10.0.14" />
    <ProjectReference Include="..\VideoSeeker.Playback\VideoSeeker.Playback.csproj" />
    <ProjectReference Include="..\VideoSeeker.Inspect\VideoSeeker.Inspect.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Para exportar clips: ffmpeg.exe usa las DLL del motor de inspección y, además, estas dos -->
    <None Include="..\..\deps\ffmpeg\ffmpeg.exe;..\..\deps\ffmpeg\avfilter-*.dll;..\..\deps\ffmpeg\avdevice-*.dll"
          Link="ffmpeg\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
