<Window x:Class="VideoSeeker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:VideoSeeker.App.Localization"
        xmlns:c="clr-namespace:VideoSeeker.App.Controls"
        Title="VideoSeeker" Width="1280" Height="800" MinWidth="480" MinHeight="320"
        Background="{StaticResource Bg}" AllowDrop="True"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- Iconos de bookmarks: la cinta de marcador de libro. Panel = cinta junto a una lista; marcas = cinta sobre
             la línea de tiempo (tachada si están ocultas). -->
        <Geometry x:Key="PanelIcon">M1.5,2 H7 V13.5 L4.25,11 L1.5,13.5 Z M10,3.5 H17 M10,8 H17 M10,12.5 H17</Geometry>
        <Geometry x:Key="MarksShownIcon">M6.5,1.5 H12.5 V11 L9.5,8.5 L6.5,11 Z M1.5,15 H17.5</Geometry>
        <!-- Exportar: el bookmark (o dos, la colección) con una flecha que sale. -->
        <Geometry x:Key="ExportBookmarksIcon">M2,2.5 H7.5 V12.5 L4.75,10 L2,12.5 Z M10.5,7.5 H17 M14,4.5 L17,7.5 L14,10.5</Geometry>
        <Geometry x:Key="ExportCollectionIcon">M2,4 H7.5 V14 L4.75,11.5 L2,14 Z M4.5,4 V1.5 H10 V11.5 L7.5,9.4 M12,7.5 H17.5 M14.75,4.75 L17.5,7.5 L14.75,10.25</Geometry>
        <!-- Guardar la zona como bookmark: la cinta con un "+". -->
        <Geometry x:Key="AddBookmarkIcon">M2,2.5 H7.5 V12.5 L4.75,10 L2,12.5 Z M13.5,4.5 V11.5 M10,8 H17</Geometry>
        <Geometry x:Key="MarksHiddenIcon">M6.5,1.5 H12.5 V11 L9.5,8.5 L6.5,11 Z M1.5,15 H17.5 M3,1 L16,13.5</Geometry>
        <Style x:Key="IconPath" TargetType="Path">
            <Setter Property="Width" Value="19" />
            <Setter Property="Height" Value="17" />
            <Setter Property="StrokeThickness" Value="1.4" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Style>

        <Style x:Key="ScopeButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource FgMuted}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Padding="8,3" Margin="0,0,4,0">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2C3440" />
                                <Setter Property="Foreground" Value="{StaticResource Fg}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Fg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mientras la lista tiene el teclado, el seleccionado lleva un borde azul grueso: al pulsar Esc o hacer
             clic fuera desaparece y se ve que las flechas vuelven al vídeo. -->
        <Style x:Key="BookmarkItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="2"
                                CornerRadius="5" Padding="3">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#262A31" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2C3440" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="Selector.IsSelectionActive" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="Bd" Property="Background" Value="#24476E" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Background="Black" MouseWheel="OnVideoWheel" MouseDown="OnMiddleClick">
            <TextBlock x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{StaticResource FgMuted}" FontSize="16" TextAlignment="Center"
                       Text="{l:Tr EmptyHint}" />
            <Border x:Name="VideoArea" Visibility="Hidden" />
        </Grid>

        <!-- Barras y botones. En pantalla completa sin fijar (chincheta o Tab) salen de aquí y flotan sobre la parte de
             abajo de la imagen, en ControlsPopup, solo mientras el ratón está abajo (MainWindow.Fullscreen.cs). -->
        <Border x:Name="ControlsHost" Grid.Row="1" Grid.ColumnSpan="2">
        <StackPanel>
        <c:SeekBar x:Name="Seek" Margin="8,4,8,0" />

        <Border x:Name="ZoomRow" Margin="8,2,8,2" Background="{StaticResource Panel}" CornerRadius="4"
                Visibility="Collapsed">
            <DockPanel>
                <Button x:Name="CloseZoomButton" DockPanel.Dock="Right" Style="{StaticResource ToolButton}" FontFamily="{StaticResource Icons}"
                        Content="&#xE711;" ToolTip="{l:Tr CloseZoomTip}" Click="OnCloseZoomClick" />
                <Button x:Name="RangeLoopButton" DockPanel.Dock="Right" Style="{StaticResource ToolButton}"
                        FontFamily="{StaticResource Icons}" Content="&#xE8EE;"
                        Click="OnRangeLoopClick" />
                <Button x:Name="MarkLastButton" DockPanel.Dock="Right" Style="{StaticResource ToolButton}" FontFamily="Segoe UI Symbol" Content="⇥"
                        Click="OnMarkLastClick" />
                <!-- Con una región seleccionada, el tramo es ella: su nombre con su color. Con un tramo libre, en su sitio,
                     el botón que lo guarda como bookmark (B); al guardarlo, el botón deja paso al nombre. -->
                <Button x:Name="SaveZoneButton" DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Margin="2,0,0,0"
                        ToolTip="{l:Tr SaveZoneTip}" Click="OnSaveZoneClick">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource AddBookmarkIcon}" />
                </Button>
                <TextBlock x:Name="ZoneName" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="8,0,2,0" FontSize="12.5"
                           FontWeight="SemiBold" MaxWidth="180" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                <Button x:Name="MarkFirstButton" DockPanel.Dock="Left" Style="{StaticResource ToolButton}" FontFamily="Segoe UI Symbol" Content="⇤"
                        Click="OnMarkFirstClick" />
                <c:ZoomBar x:Name="Zoom" />
            </DockPanel>
        </Border>

        <!-- Controles: a la izquierda abrir y los tiempos; en el centro, como en los editores, frame atrás, reproducir,
             frame adelante y el bucle; a la derecha, volumen, pistas, ajustes, pantalla completa y bookmarks. -->
        <Grid Margin="8,0,8,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0">
            <!-- El bucle a la izquierda y la velocidad a la derecha, del mismo ancho: el play queda justo en el centro. -->
            <Button x:Name="LoopButton" Style="{StaticResource ToolButton}" FontFamily="{StaticResource Icons}" Content="&#xE8EE;"
                    Width="56" Margin="0,0,6,0" ToolTip="{l:Tr VideoLoopTip}" Click="OnLoopClick" />
            <RepeatButton Style="{StaticResource ToolRepeatButton}" FontFamily="{StaticResource Icons}" Content="&#xE892;"
                          ToolTip="{l:Tr PreviousFrameTip}" Click="OnStepBackClick" MouseWheel="OnFrameWheel" />
            <Button x:Name="PlayButton" Style="{StaticResource ToolButton}" FontFamily="{StaticResource Icons}" FontSize="18"
                    Content="&#xE768;" ToolTip="{l:Tr PlayTip}" Click="OnPlayClick" MouseWheel="OnFrameWheel" />
            <RepeatButton Style="{StaticResource ToolRepeatButton}" FontFamily="{StaticResource Icons}" Content="&#xE893;"
                          ToolTip="{l:Tr NextFrameTip}" Click="OnStepForwardClick" MouseWheel="OnFrameWheel" />
            <Button x:Name="SpeedButton" Style="{StaticResource ToolButton}" Width="56" Margin="6,0,0,0" Padding="4,4"
                    ToolTip="{l:Tr SpeedTip}" Click="OnSpeedClick" MouseWheel="OnSpeedWheel"
                    PreviewMouseDown="OnMiddleClick">
                <TextBlock x:Name="SpeedText" FontFamily="Consolas" FontSize="13" Text="1×" />
            </Button>
          </StackPanel>
          <DockPanel Grid.Column="0" LastChildFill="False" ClipToBounds="True">
            <!-- Historial de vídeos, como en el navegador; clic derecho: la lista de ese lado. -->
            <Button x:Name="HistoryBackButton" Style="{StaticResource ToolButton}" FontFamily="{StaticResource Icons}" FontSize="13"
                    Padding="6,4" Content="&#xE72B;" ToolTipService.ShowOnDisabled="True"
                    Click="OnHistoryBackClick" MouseRightButtonUp="OnHistoryRightClick" />
            <Button x:Name="HistoryForwardButton" Style="{StaticResource ToolButton}" FontFamily="{StaticResource Icons}" FontSize="13"
                    Padding="6,4" Content="&#xE72A;" ToolTipService.ShowOnDisabled="True"
                    Click="OnHistoryForwardClick" MouseRightButtonUp="OnHistoryRightClick" />
            <Button x:Name="OpenButton" Style="{StaticResource ToolButton}" FontFamily="{StaticResource Icons}"
                    Content="&#xE8E5;" ToolTip="{l:Tr OpenVideoTip}" Click="OnOpenClick" />
            <TextBlock x:Name="TimeText" VerticalAlignment="Center" Margin="8,0" Foreground="{StaticResource Fg}"
                       FontFamily="Consolas" FontSize="13" Text="00:00.000 / 00:00" />
            <TextBlock x:Name="FrameText" VerticalAlignment="Center" Margin="4,0" Foreground="{StaticResource FgMuted}"
                       FontFamily="Consolas" FontSize="13" />
            <!-- Con un tramo ampliado: dónde se está respecto a él (dentro, sin signo; antes, "−"; después, "+"). -->
            <TextBlock x:Name="RangePosText" VerticalAlignment="Center" Margin="4,0" Foreground="{StaticResource FgMuted}"
                       FontFamily="Consolas" FontSize="13" ToolTip="{l:Tr RangePositionTip}" />
            <TextBlock x:Name="BookmarkText" VerticalAlignment="Center" Margin="8,0" Foreground="{StaticResource Fg}"
                       FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="320"
                       ToolTip="{l:Tr CurrentBookmarkTip}" />
          </DockPanel>
          <DockPanel Grid.Column="2" LastChildFill="False">

            <!-- Bookmarks a la derecha del todo, como su panel: el del panel en el extremo y el ojo de las marcas a su
                 izquierda, separados del resto. -->
            <Button DockPanel.Dock="Right" x:Name="BookmarksButton" Style="{StaticResource ToolButton}"
                    ToolTip="{l:Tr BookmarksButtonTip}" Click="OnBookmarksButtonClick">
                <Path Style="{StaticResource IconPath}" Data="{StaticResource PanelIcon}" />
            </Button>
            <!-- El halo de detrás solo se ve cuando el ojo late para avisar de que las marcas están ocultas
                 (PulseMarksButtonIfHidden); crece fuera del botón sin mover nada. -->
            <Grid DockPanel.Dock="Right">
                <Border x:Name="MarksPulseRing" CornerRadius="4" BorderThickness="1.5" BorderBrush="{StaticResource Accent}"
                        Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform />
                    </Border.RenderTransform>
                </Border>
                <Button x:Name="MarksButton" Style="{StaticResource ToolButton}" Click="OnMarksButtonClick">
                    <Path x:Name="MarksIcon" Style="{StaticResource IconPath}" Data="{StaticResource MarksShownIcon}"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <ScaleTransform />
                        </Path.RenderTransform>
                    </Path>
                </Button>
            </Grid>
            <Rectangle DockPanel.Dock="Right" Width="1" Margin="6,6" Fill="{StaticResource Line}" />
            <Button DockPanel.Dock="Right" x:Name="FullscreenButton" Style="{StaticResource ToolButton}"
                    FontFamily="{StaticResource Icons}" Content="&#xE740;" ToolTip="{l:Tr FullscreenTip}" Click="OnFullscreenClick" />
            <!-- Solo en pantalla completa: fijar los controles o dejar que se escondan (Tab). -->
            <Button DockPanel.Dock="Right" x:Name="PinButton" Style="{StaticResource ToolButton}" FontFamily="{StaticResource Icons}"
                    Content="&#xE718;" Visibility="Collapsed" Click="OnPinClick" />
            <Button DockPanel.Dock="Right" x:Name="SettingsButton" Style="{StaticResource ToolButton}" FontFamily="{StaticResource Icons}"
                    Content="&#xE713;" ToolTip="{l:Tr SettingsTip}" Click="OnSettingsClick" />
            <Button DockPanel.Dock="Right" x:Name="TracksButton" Style="{StaticResource ToolButton}" IsEnabled="False"
                    FontFamily="{StaticResource Icons}" Content="&#xE7F0;" ToolTip="{l:Tr TracksTip}" Click="OnTracksClick" />
            <Slider DockPanel.Dock="Right" x:Name="VolumeSlider" Style="{StaticResource DarkSlider}" Width="110" Minimum="0" Maximum="100"
                    VerticalAlignment="Center" Margin="0,0,8,0" Focusable="False" IsMoveToPointEnabled="True"
                    ValueChanged="OnVolumeChanged" ToolTip="{l:Tr VolumeTip}" />
            <Button DockPanel.Dock="Right" x:Name="MuteButton" Style="{StaticResource ToolButton}"
                    FontFamily="{StaticResource Icons}" Content="&#xE767;" ToolTip="{l:Tr MuteTip}" Click="OnMuteClick" />
            <!-- Solo con clips (Ctrl + M): mientras se exporta, el progreso; después, el último clip a mano. -->
            <Button DockPanel.Dock="Right" x:Name="ExportButton" Style="{StaticResource ToolButton}" Margin="0,0,10,0" Padding="0"
                    VerticalAlignment="Center" Visibility="Collapsed" Click="OnExportButtonClick">
                <Grid x:Name="ExportPill" Height="26" MinWidth="150">
                    <Border Background="#2A2E36" CornerRadius="13" />
                    <Border x:Name="ExportFill" CornerRadius="13" HorizontalAlignment="Left" Width="0" />
                    <StackPanel Orientation="Horizontal" Margin="12,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="ExportGlyph" FontFamily="{StaticResource Icons}" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock x:Name="ExportText" FontSize="12.5" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Button>
          </DockPanel>
        </Grid>
        </StackPanel>
        </Border>

        <Popup x:Name="ControlsPopup" AllowsTransparency="True" StaysOpen="True" Placement="Relative" PopupAnimation="None" />

        <!-- Panel de bookmarks: a la derecha del vídeo y solo a su altura, para que las barras y los botones de abajo no
             se muevan. El vídeo se estrecha (la imagen es una ventana nativa y no se puede tapar). -->
        <Border x:Name="BookmarkPanel" Grid.Column="1" Width="330" MinWidth="260" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,1" Visibility="Collapsed">
          <Grid>
            <DockPanel Margin="8">
                <DockPanel DockPanel.Dock="Top">
                    <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" FontFamily="{StaticResource Icons}"
                            Content="&#xE711;" ToolTip="{l:Tr CloseBookmarkPanelTip}" Click="OnClosePanelClick" />
                    <Button DockPanel.Dock="Right" x:Name="ExportBookmarksButton" Style="{StaticResource ToolButton}"
                            ToolTip="{l:Tr ExportVideoBookmarksTip}" Click="OnExportClick">
                        <Path x:Name="ExportIcon" Style="{StaticResource IconPath}" Data="{StaticResource ExportBookmarksIcon}" />
                    </Button>
                    <TextBlock Text="{l:Tr BookmarksTitle}" Foreground="{StaticResource Fg}" FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="4,0" />
                </DockPanel>
                <Button DockPanel.Dock="Top" x:Name="CollectionButton" Style="{StaticResource ToolButton}" FontSize="12.5"
                        HorizontalAlignment="Left" Margin="0,2,0,0" Click="OnCollectionClick"
                        ToolTip="{l:Tr CollectionTip}">
                    <TextBlock x:Name="CollectionText" />
                </Button>
                <Grid DockPanel.Dock="Top" Margin="0,6,0,0">
                    <TextBox x:Name="BookmarkSearch" Style="{StaticResource DarkTextBox}"
                             TextChanged="OnBookmarkSearchChanged" PreviewKeyDown="OnBookmarkSearchKeyDown" />
                    <TextBlock Text="{l:Tr SearchPlaceholder}" Foreground="{StaticResource FgMuted}" FontSize="13" Margin="9,4,0,0"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=BookmarkSearch}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,6,0,4">
                    <RadioButton x:Name="ScopeThis" Style="{StaticResource ScopeButton}" Content="{l:Tr ScopeThisVideo}" IsChecked="True"
                                 Checked="OnScopeChanged" />
                    <RadioButton x:Name="ScopeAll" Style="{StaticResource ScopeButton}" Content="{l:Tr ScopeAllVideos}"
                                 Checked="OnScopeChanged" />
                </StackPanel>
                <!-- Etiquetas de la colección: clic filtra la lista (varias a la vez), clic derecho las gestiona, + añade una. -->
                <WrapPanel DockPanel.Dock="Top" x:Name="LabelChips" Margin="0,0,0,4" />
                <Grid>
                    <!-- Instrucciones de fondo, apagadas, detrás de la lista; se ocultan en cuanto los bookmarks llegan a su altura. -->
                    <TextBlock x:Name="PanelHint" Foreground="{StaticResource FgMuted}" FontSize="11.5" Opacity="0.55"
                               TextWrapping="Wrap" Margin="2,6,2,0" VerticalAlignment="Bottom" IsHitTestVisible="False"
                               Text="{l:Tr PanelHint}" />
                    <ListBox x:Name="BookmarkList" Background="Transparent" BorderThickness="0" SelectionMode="Extended"
                             ItemContainerStyle="{StaticResource BookmarkItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"
                             PreviewKeyDown="OnBookmarkListKeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{Binding ColorBrush}" CornerRadius="2" />
                                    <Border Grid.Column="1" Margin="6,0,0,0" Width="108" Height="61" Background="#0E0F12" CornerRadius="2">
                                        <Image Source="{Binding Thumb}" Stretch="Uniform" />
                                    </Border>
                                    <StackPanel Grid.Column="2" Margin="8,0,4,0" VerticalAlignment="Center">
                                        <!-- El nombre, en hasta dos líneas (cuatro si los tiempos van en la vista previa); el tiempo, en las
                                             que haga falta; el del vídeo se puede cortar. -->
                                        <TextBlock FontSize="13" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                   LineStackingStrategy="BlockLineHeight" LineHeight="17" MaxHeight="{Binding NameMaxHeight}"><Run
                                                Text="{Binding LabelText, Mode=OneWay}" Foreground="{Binding ColorBrush, Mode=OneWay}"
                                                FontWeight="SemiBold" FontSize="12" /><Run Text="{Binding Name, Mode=OneWay}" /></TextBlock>
                                        <TextBlock Text="{Binding TimeText}" Visibility="{Binding TimeVisibility}" Foreground="{StaticResource FgMuted}"
                                                   FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding VideoName}" Visibility="{Binding VideoVisibility}"
                                                   Foreground="{StaticResource FgMuted}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="{Binding KeyText}" Foreground="{StaticResource FgMuted}"
                                               FontFamily="Consolas" FontSize="12" VerticalAlignment="Top" Margin="0,2,2,0"
                                               ToolTip="{l:Tr BookmarkKeyTip}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </DockPanel>
            <!-- Borde izquierdo: se arrastra para cambiar el ancho del panel (doble clic, el de por defecto). -->
            <Thumb x:Name="PanelGrip" HorizontalAlignment="Left" Width="6" Cursor="SizeWE">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent">
                            <Rectangle x:Name="Line" Width="2" HorizontalAlignment="Left" Fill="{StaticResource Accent}" Visibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Line" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Line" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
          </Grid>
        </Border>

        <!-- Nombre de un bookmark nuevo o renombrado, encima de su marca en la barra. -->
        <Popup x:Name="NamePopup" AllowsTransparency="True" StaysOpen="False" Placement="Top" Closed="OnNamePopupClosed">
            <!-- Todo se puede usar con el teclado: Tab recorre el nombre, las etiquetas, «+ Nueva», los colores y Aceptar (y vuelve
                 a empezar); Intro guarda y Esc cancela desde cualquiera de ellos (MainWindow.Labels.cs). -->
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                    CornerRadius="4" Padding="8,6" Margin="0,0,0,4" KeyboardNavigation.TabNavigation="Cycle" KeyDown="OnNamePopupKeyDown">
                <StackPanel Width="260">
                    <!-- Arriba qué se nombra; debajo, más tenue, de qué (el tramo de la región, el vídeo): en dos líneas
                         cabe siempre, también con horas o nombres largos. -->
                    <TextBlock x:Name="NameCaption" Foreground="{StaticResource Fg}" FontSize="11.5" TextWrapping="Wrap" />
                    <TextBlock x:Name="NameDetail" Foreground="{StaticResource FgMuted}" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed" />
                    <Border Height="4" />
                    <TextBox x:Name="NameBox" Style="{StaticResource DarkTextBox}" PreviewKeyDown="OnNameBoxKeyDown" />
                    <!-- Solo con un bookmark: etiquetas (clic o Alt + número), «Sin etiqueta», «+ Nueva» y los colores sueltos.
                         O etiqueta o color: elegir un color quita la etiqueta. -->
                    <WrapPanel x:Name="NameLabels" Margin="0,6,0,0" Visibility="Collapsed" />
                    <DockPanel x:Name="NewLabelRow" Margin="0,2,0,4" Visibility="Collapsed">
                        <TextBlock DockPanel.Dock="Left" Text="{l:Tr NewLabelTitle}" Foreground="{StaticResource FgMuted}" FontSize="11.5"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="NewLabelBox" Style="{StaticResource DarkTextBox}" PreviewKeyDown="OnNewLabelBoxKeyDown"
                                 ToolTip="{l:Tr NewLabelBoxTip}" />
                    </DockPanel>
                    <WrapPanel x:Name="NameColors" Margin="0,0,0,0" Visibility="Collapsed" />
                    <DockPanel Margin="0,4,0,0" LastChildFill="True">
                        <Button x:Name="NameAccept" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="{l:Tr Ok}"
                                FontSize="12" Padding="10,2" Margin="8,0,0,0" VerticalAlignment="Bottom" Click="OnNameAcceptClick" />
                        <TextBlock x:Name="NameHint" Text="{l:Tr NameHint}" Foreground="{StaticResource FgMuted}"
                                   FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Miniatura y nombre al pasar el ratón por un bookmark de las barras. -->
        <Popup x:Name="HoverPopup" AllowsTransparency="True" StaysOpen="True" Placement="Top" IsHitTestVisible="False">
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="4" Padding="4" Margin="0,0,0,2" IsHitTestVisible="False">
                <StackPanel Width="240">
                    <Grid Height="135" Background="#0E0F12">
                        <TextBlock x:Name="HoverWait" Text="{l:Tr GeneratingThumbnail}" Foreground="{StaticResource FgMuted}"
                                   FontSize="11.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image x:Name="HoverImage" Stretch="Uniform" />
                    </Grid>
                    <!-- Nombres largos: hasta seis líneas. -->
                    <TextBlock x:Name="HoverName" Foreground="{StaticResource Fg}" FontSize="13" Margin="2,4,2,2"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               LineStackingStrategy="BlockLineHeight" LineHeight="17" MaxHeight="102" />
                    <TextBlock x:Name="HoverTime" Foreground="{StaticResource FgMuted}" FontFamily="Consolas" FontSize="11.5"
                               Margin="2,0,2,2" />
                </StackPanel>
            </Border>
        </Popup>

        <!-- Vistazo: el frame que hay bajo el cursor al pasar el ratón por las barras (sin ir a él). Su tamaño sigue la
             proporción del vídeo (MainWindow.Peek.cs). -->
        <Popup x:Name="PeekPopup" AllowsTransparency="True" StaysOpen="True" Placement="Top" IsHitTestVisible="False">
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="4" Padding="3" Margin="0,0,0,2" IsHitTestVisible="False">
                <Grid x:Name="PeekBox" Width="240" Height="135" Background="#0E0F12">
                    <TextBlock x:Name="PeekWait" Text="{l:Tr Loading}" Foreground="{StaticResource FgMuted}"
                               FontSize="11.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image x:Name="PeekImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>
            </Border>
        </Popup>

        <!-- Avisos breves, centrados abajo sobre la imagen y bien grandes (la imagen puede ser del motor, que tapa el
             texto en pantalla de mpv). -->
        <!-- Al acabar un clip, como el aviso de descargas de los navegadores: dónde ha quedado y cómo llegar a él. -->
        <Popup x:Name="ClipPopup" AllowsTransparency="True" StaysOpen="True" Placement="Relative"
               PlacementTarget="{Binding ElementName=VideoArea}">
            <Border Background="#F0202329" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="16,10,10,14" Width="400">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Padding="6,3" FontFamily="{StaticResource Icons}"
                                FontSize="11" Content="&#xE711;" ToolTip="{l:Tr Close}" Click="OnClipPopupCloseClick" />
                        <TextBlock x:Name="ClipPopupGlyph" FontFamily="{StaticResource Icons}" FontSize="15" VerticalAlignment="Center" />
                        <TextBlock x:Name="ClipPopupTitle" Foreground="{StaticResource Fg}" FontSize="15" FontWeight="SemiBold"
                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock x:Name="ClipPopupName" Foreground="{StaticResource Fg}" FontSize="13" Margin="0,6,6,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ClipPopupDetail" Foreground="{StaticResource FgMuted}" FontSize="12" Margin="0,3,6,0" TextWrapping="Wrap" />
                    <StackPanel x:Name="ClipPopupButtons" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource AccentButton}" Content="{l:Tr ShowInFolder}" Click="OnClipRevealClick" />
                        <Button x:Name="ClipPopupSecond" Style="{StaticResource DarkButton}" Content="{l:Tr Open}" Margin="8,0,0,0" Click="OnClipOpenClick" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="ToastPopup" AllowsTransparency="True" StaysOpen="True" Placement="Relative" IsHitTestVisible="False"
               PlacementTarget="{Binding ElementName=VideoArea}">
            <Border Background="#D8101215" CornerRadius="6" Padding="18,8" IsHitTestVisible="False">
                <TextBlock x:Name="ToastText" Foreground="{StaticResource Fg}" FontSize="22" TextWrapping="Wrap" TextAlignment="Center" />
            </Border>
        </Popup>
    </Grid>
</Window>
