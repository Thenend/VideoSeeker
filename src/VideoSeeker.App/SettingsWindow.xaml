<Window x:Class="VideoSeeker.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajustes — VideoSeeker" Width="620" SizeToContent="Height" MinWidth="520" MinHeight="300"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" UseLayoutRounding="True">
    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <SolidColorBrush x:Key="BoxBorder" Color="#5A616B" />
        <SolidColorBrush x:Key="Card" Color="#1F2228" />
        <SolidColorBrush x:Key="RowLine" Color="#2A2E35" />

        <!-- Explicaciones de cada opción: al pasar el ratón por su nombre. -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#2A2E35" />
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="MaxWidth" Value="360" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cada sección, en su recuadro. -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Card}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,4,14,4" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource FgMuted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="4,0,0,6" />
        </Style>
        <!-- Una opción: nombre a la izquierda, control a la derecha. -->
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="MinHeight" Value="40" />
        </Style>
        <Style x:Key="Divider" TargetType="Rectangle">
            <Setter Property="Height" Value="1" />
            <Setter Property="Fill" Value="{StaticResource RowLine}" />
        </Style>
        <!-- Nombre de la opción; su explicación sale en el tooltip, solo sobre el nombre (no sobre el control, para
             no estorbar al bajar al siguiente). Tan ancho como el texto. -->
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="350" />
            <Setter Property="ToolTipService.ShowDuration" Value="30000" />
        </Style>
        <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource FgMuted}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="NumberBox" TargetType="TextBox" BasedOn="{StaticResource DarkTextBox}">
            <Setter Property="Width" Value="46" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Interruptor (CheckBox). -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="38" Height="20" CornerRadius="10" BorderThickness="1"
                                BorderBrush="{StaticResource BoxBorder}" Background="{StaticResource Bg}">
                            <Ellipse x:Name="Knob" Width="12" Height="12" Margin="3,0" HorizontalAlignment="Left"
                                     Fill="{StaticResource FgMuted}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Fg}" />
                                <Setter TargetName="Knob" Property="Fill" Value="{StaticResource Fg}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Fg}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="Knob" Property="Fill" Value="White" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botones de un grupo (formato del tiempo). -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource FgMuted}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Padding="10,4">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Fg}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2C4566" />
                                <Setter Property="Foreground" Value="{StaticResource Fg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Muestras de color de los bookmarks: el color va en Background. -->
        <Style x:Key="Swatch" TargetType="RadioButton">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="3,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Ring" CornerRadius="12" BorderThickness="2" BorderBrush="Transparent" Padding="3">
                            <Border CornerRadius="8" Background="{TemplateBinding Background}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource FgMuted}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Width" Value="190" />
            <Setter Property="Height" Value="27" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MaxDropDownHeight" Value="640" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press" Cursor="Hand"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}"
                                                BorderThickness="1" CornerRadius="3">
                                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Icons}" FontSize="10"
                                                       Foreground="{StaticResource FgMuted}" HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" Margin="0,0,9,0" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource FgMuted}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Margin="9,0,28,0" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                        CornerRadius="3" Margin="0,2,0,0" Padding="2"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="2" Padding="8,3">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2C4566" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <DockPanel Background="{StaticResource Bg}">
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,10">
            <DockPanel>
                <Button x:Name="ResetButton" DockPanel.Dock="Right" Style="{StaticResource DarkButton}"
                        Content="Restablecer valores por defecto" Click="OnResetClick" />
                <!-- Apoyar al autor y código fuente (enlaces en AppLinks.cs). -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SupportButton" Style="{StaticResource DarkButton}" Click="OnSupportClick"
                            ToolTip="VideoSeeker es gratis. Si te resulta útil, puedes invitar al autor a un café.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource Icons}" Text="&#xEB52;" Foreground="#E5484D"
                                       FontSize="12" VerticalAlignment="Center" Margin="0,1,6,0" />
                            <TextBlock Text="Apoyar" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource DarkButton}" Click="OnSourceClick" Margin="6,0,0,0"
                            Content="Código fuente" ToolTip="Software libre, con licencia GPL v3." />
                    <TextBlock x:Name="VersionText" Style="{StaticResource Small}" FontSize="11.5" Margin="10,0,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="20,16,20,4">
                <!-- Barras -->
                <TextBlock Style="{StaticResource Section}" Text="BARRAS" />
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox DockPanel.Dock="Right" x:Name="MoveRegionsCheck" Style="{StaticResource Switch}" />
                            <TextBlock Style="{StaticResource Label}" ToolTip="Arrastrar el centro del tramo ampliado o de una región de bookmark la desplaza entera. Desactivado, mueve el cursor de la barra." Text="Mover regiones enteras arrastrando su centro" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource Divider}" />
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox DockPanel.Dock="Right" x:Name="EdgeFrameCheck" Style="{StaticResource Switch}" />
                            <TextBlock Style="{StaticResource Label}" ToolTip="Al arrastrar un extremo del tramo ampliado o de un bookmark. Desactivado, la imagen no cambia." Text="Ver el frame del extremo que se arrastra" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource Divider}" />
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox DockPanel.Dock="Right" x:Name="CachedLineCheck" Style="{StaticResource Switch}" />
                            <TextBlock Style="{StaticResource Label}" ToolTip="Marca bajo las barras lo que ya está en la caché: ahí se salta al instante." Text="Línea verde de la caché de frames" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource Divider}" />
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox DockPanel.Dock="Right" x:Name="MarksCheck" Style="{StaticResource Switch}" />
                            <TextBlock Style="{StaticResource Label}" ToolTip="Atajo: Ctrl + Shift + B." Text="Marcas de los bookmarks" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Navegación -->
                <TextBlock Style="{StaticResource Section}" Text="NAVEGACIÓN" />
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox x:Name="SeekBox" Style="{StaticResource NumberBox}" />
                                <TextBlock Style="{StaticResource Small}" Text="s" Margin="5,0,14,0" />
                                <TextBlock Style="{StaticResource Small}" Text="Shift" Margin="0,0,6,0" />
                                <TextBox x:Name="SeekShiftBox" Style="{StaticResource NumberBox}" />
                                <TextBlock Style="{StaticResource Small}" Text="s" Margin="5,0,14,0" />
                                <TextBlock Style="{StaticResource Small}" Text="Ctrl" Margin="0,0,6,0" />
                                <TextBox x:Name="SeekCtrlBox" Style="{StaticResource NumberBox}" />
                                <TextBlock Style="{StaticResource Small}" Text="s" Margin="5,0,0,0" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Label}" ToolTip="Segundos que salta cada flecha: sola, con Shift o con Ctrl." Text="Saltos con ← →" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource Divider}" />
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock DockPanel.Dock="Right" x:Name="ScrubText" Style="{StaticResource Small}" Width="92" Margin="10,0,0,0" />
                            <Slider DockPanel.Dock="Right" x:Name="ScrubSlider" Style="{StaticResource DarkSlider}" Width="200" Minimum="1" Maximum="20" TickFrequency="1"
                                    IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" VerticalAlignment="Center" Focusable="False" />
                            <TextBlock Style="{StaticResource Label}" ToolTip="Píxeles que hay que arrastrar sobre la imagen, con el botón pulsado, para avanzar un frame." Text="Sensibilidad del scrubbing" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource Divider}" />
                        <DockPanel Style="{StaticResource Row}">
                            <ComboBox DockPanel.Dock="Right" x:Name="WheelCombo" Style="{StaticResource DarkCombo}">
                                <ComboBoxItem Content="Velocidad" Tag="speed" />
                                <ComboBoxItem Content="Volumen" Tag="volume" />
                            </ComboBox>
                            <TextBlock Style="{StaticResource Label}" ToolTip="Velocidad: ±0,1× (botón central: 1×). Volumen: ±5 %." Text="Rueda del ratón sobre el vídeo" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource Divider}" />
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox DockPanel.Dock="Right" x:Name="ResumeCheck" Style="{StaticResource Switch}" />
                            <TextBlock Style="{StaticResource Label}" Text="Reanudar cada vídeo donde se dejó" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Tiempo y bookmarks -->
                <TextBlock Style="{StaticResource Section}" Text="TIEMPO Y BOOKMARKS" />
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton x:Name="TimeMsRadio" Style="{StaticResource Segment}" GroupName="Time" Content="01:23.456" />
                                <RadioButton x:Name="TimeFramesRadio" Style="{StaticResource Segment}" GroupName="Time" Content="00:01:23:11" Margin="4,0,0,0" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Label}" ToolTip="En 00:01:23:11, el último número es el frame dentro de cada segundo." Text="Formato del tiempo" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource Divider}" />
                        <DockPanel Style="{StaticResource Row}">
                            <StackPanel DockPanel.Dock="Right" x:Name="ColorPanel" Orientation="Horizontal" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource Label}" ToolTip="El de los que no llevan etiqueta." Text="Color de los bookmarks nuevos" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource Divider}" />
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox DockPanel.Dock="Right" x:Name="RepeatLabelCheck" Style="{StaticResource Switch}" />
                            <TextBlock Style="{StaticResource Label}" ToolTip="Al crear un bookmark ya lleva la etiqueta del anterior; en el cuadro del nombre se cambia o se quita." Text="Repetir la última etiqueta en los nuevos" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource Divider}" />
                        <DockPanel Style="{StaticResource Row}">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton x:Name="TimesPreviewRadio" Style="{StaticResource Segment}" GroupName="BookmarkTimes" Content="Vista previa" />
                                <RadioButton x:Name="TimesListRadio" Style="{StaticResource Segment}" GroupName="BookmarkTimes" Content="Lista" Margin="4,0,0,0" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Label}" ToolTip="En la lista se ven todos de un vistazo. En la vista previa, la lista deja más sitio al nombre." Text="Tiempos de los bookmarks" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Audio y subtítulos -->
                <TextBlock Style="{StaticResource Section}" Text="AUDIO Y SUBTÍTULOS" />
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <ComboBox DockPanel.Dock="Right" x:Name="AudioLangCombo" Style="{StaticResource DarkCombo}" />
                            <TextBlock Style="{StaticResource Label}" ToolTip="Se elige esa pista si el vídeo trae varias. Se aplica al abrir el siguiente vídeo." Text="Idioma preferido del audio" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource Divider}" />
                        <DockPanel Style="{StaticResource Row}">
                            <ComboBox DockPanel.Dock="Right" x:Name="SubLangCombo" Style="{StaticResource DarkCombo}" />
                            <TextBlock Style="{StaticResource Label}" ToolTip="Se elige esa pista al activar los subtítulos. Se aplica al abrir el siguiente vídeo." Text="Idioma preferido de los subtítulos" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource Divider}" />
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox DockPanel.Dock="Right" x:Name="SubsOnOpenCheck" Style="{StaticResource Switch}" />
                            <TextBlock Style="{StaticResource Label}" ToolTip="Se aplica al abrir el siguiente vídeo." Text="Activar los subtítulos al abrir un vídeo" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Rendimiento -->
                <TextBlock Style="{StaticResource Section}" Text="RENDIMIENTO" />
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock DockPanel.Dock="Right" x:Name="CacheText" Style="{StaticResource Small}" Width="92" Margin="10,0,0,0" />
                            <Slider DockPanel.Dock="Right" x:Name="CacheSlider" Style="{StaticResource DarkSlider}" Width="200" Minimum="512" TickFrequency="256"
                                    IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" VerticalAlignment="Center" Focusable="False" />
                            <TextBlock x:Name="CacheLabel" Style="{StaticResource Label}" Text="Memoria de la caché de frames" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource Divider}" />
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox DockPanel.Dock="Right" x:Name="HwdecCheck" Style="{StaticResource Switch}" />
                            <TextBlock Style="{StaticResource Label}" ToolTip="Reproduce con la tarjeta gráfica. Desactívala solo si un vídeo se ve mal." Text="Decodificación por hardware" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Clips (Ctrl + M) -->
                <TextBlock Style="{StaticResource Section}" Text="EXPORTAR CLIPS" />
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource DarkButton}" Content="Cambiar…" Click="OnChangeClipFolderClick" Margin="10,0,0,0" />
                                <Button x:Name="ClipFolderBesideButton" Style="{StaticResource DarkButton}" Content="Junto al vídeo"
                                        Click="OnClipFolderBesideClick" Margin="6,0,0,0" />
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Label}" ToolTip="Dónde se guardan los clips exportados. Si no se puede escribir allí, van a Vídeos\VideoSeeker." Text="Carpeta de destino" />
                                <TextBlock x:Name="ClipFolderText" Style="{StaticResource Small}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                        <Rectangle Style="{StaticResource Divider}" />
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox DockPanel.Dock="Right" x:Name="ClipClipboardCheck" Style="{StaticResource Switch}" />
                            <TextBlock Style="{StaticResource Label}" ToolTip="Como archivo, para pegarlo directamente en un chat, en Jira o en una carpeta." Text="Copiar cada clip al portapapeles" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource Divider}" />
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock DockPanel.Dock="Right" x:Name="LightClipText" Style="{StaticResource Small}" Width="92" Margin="10,0,0,0" />
                            <Slider DockPanel.Dock="Right" x:Name="LightClipSlider" Style="{StaticResource DarkSlider}" Width="200" Minimum="0.25" Maximum="4" TickFrequency="0.25"
                                    IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" VerticalAlignment="Center" Focusable="False" />
                            <TextBlock Style="{StaticResource Label}" ToolTip="Megas por cada segundo de clip, con el audio. Nunca más que el vídeo original." Text="Tamaño del clip ligero" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- General -->
                <TextBlock Style="{StaticResource Section}" Text="GENERAL" />
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource DarkButton}" Content="Abrir" Click="OnOpenDataFolderClick" Margin="10,0,0,0" />
                                <Button Style="{StaticResource DarkButton}" Content="Cambiar…" Click="OnChangeDataFolderClick" Margin="6,0,0,0" />
                                <Button x:Name="DefaultFolderButton" Style="{StaticResource DarkButton}" Content="Por defecto"
                                        Click="OnDefaultDataFolderClick" Margin="6,0,0,0"
                                        ToolTip="La carpeta data, junto al programa." />
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Label}" ToolTip="Ajustes, bookmarks y posición de cada vídeo. El cambio se aplica al reiniciar." Text="Carpeta de datos" />
                                <TextBlock x:Name="DataFolderText" Style="{StaticResource Small}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock x:Name="PendingFolderText" Foreground="{StaticResource Accent}" FontSize="12" TextWrapping="Wrap"
                                   Margin="0,0,0,8" Visibility="Collapsed" />
                        <Rectangle Style="{StaticResource Divider}" />
                        <DockPanel Style="{StaticResource Row}">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource DarkButton}" Content="Elegir en Windows" Click="OnChooseInWindowsClick" Margin="10,0,0,0" />
                                <Button x:Name="UnregisterButton" Style="{StaticResource DarkButton}" Content="Quitar" Click="OnUnregisterClick" Margin="6,0,0,0" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Label}" Text="Reproductor de vídeo predeterminado"
                                       ToolTip="Añade los tipos de vídeo a «Abrir con» y lleva a Aplicaciones predeterminadas de Windows, donde se elige para cuáles." />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
