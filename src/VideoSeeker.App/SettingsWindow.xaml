<Window x:Class="VideoSeeker.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:VideoSeeker.App.Localization"
        Title="{l:Tr SettingsTitle}" Width="620" SizeToContent="Height" MinWidth="520" MinHeight="300"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" UseLayoutRounding="True">
    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <SolidColorBrush x:Key="BoxBorder" Color="#5A616B" />
        <SolidColorBrush x:Key="Card" Color="#1F2228" />
        <SolidColorBrush x:Key="RowLine" Color="#2A2E35" />

        <!-- Explicaciones de cada opción: al pasar el ratón por su nombre. -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#2A2E35" />
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="MaxWidth" Value="360" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cada sección, en su recuadro. -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Card}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,4,14,4" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource FgMuted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="4,0,0,6" />
        </Style>
        <!-- Una opción: nombre a la izquierda, control a la derecha. -->
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="MinHeight" Value="40" />
        </Style>
        <Style x:Key="Divider" TargetType="Rectangle">
            <Setter Property="Height" Value="1" />
            <Setter Property="Fill" Value="{StaticResource RowLine}" />
        </Style>
        <!-- Nombre de la opción; su explicación sale en el tooltip, solo sobre el nombre (no sobre el control, para
             no estorbar al bajar al siguiente). Tan ancho como el texto. -->
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="350" />
            <Setter Property="ToolTipService.ShowDuration" Value="30000" />
        </Style>
        <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource FgMuted}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="NumberBox" TargetType="TextBox" BasedOn="{StaticResource DarkTextBox}">
            <Setter Property="Width" Value="46" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Interruptor (CheckBox). -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="38" Height="20" CornerRadius="10" BorderThickness="1"
                                BorderBrush="{StaticResource BoxBorder}" Background="{StaticResource Bg}">
                            <Ellipse x:Name="Knob" Width="12" Height="12" Margin="3,0" HorizontalAlignment="Left"
                                     Fill="{StaticResource FgMuted}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Fg}" />
                                <Setter TargetName="Knob" Property="Fill" Value="{StaticResource Fg}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Fg}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="Knob" Property="Fill" Value="White" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botones de un grupo (formato del tiempo). -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource FgMuted}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Padding="10,4">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Fg}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2C4566" />
                                <Setter Property="Foreground" Value="{StaticResource Fg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Muestras de color de los bookmarks: el color va en Background. -->
        <Style x:Key="Swatch" TargetType="RadioButton">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="3,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Ring" CornerRadius="12" BorderThickness="2" BorderBrush="Transparent" Padding="3">
                            <Border CornerRadius="8" Background="{TemplateBinding Background}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource FgMuted}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Width" Value="190" />
            <Setter Property="Height" Value="27" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MaxDropDownHeight" Value="640" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press" Cursor="Hand"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}"
                                                BorderThickness="1" CornerRadius="3">
                                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Icons}" FontSize="10"
                                                       Foreground="{StaticResource FgMuted}" HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" Margin="0,0,9,0" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource FgMuted}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Margin="9,0,28,0" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                        CornerRadius="3" Margin="0,2,0,0" Padding="2"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="2" Padding="8,3">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2C4566" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <DockPanel Background="{StaticResource Bg}">
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,10">
            <DockPanel>
                <Button x:Name="ResetButton" DockPanel.Dock="Right" Style="{StaticResource DarkButton}"
                        Content="{l:Tr ResetDefaults}" Click="OnResetClick" />
                <!-- Apoyar al autor y código fuente (enlaces en AppLinks.cs). -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SupportButton" Style="{StaticResource DarkButton}" Click="OnSupportClick"
                            ToolTip="{l:Tr SupportTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource Icons}" Text="&#xEB52;" Foreground="#E5484D"
                                       FontSize="12" VerticalAlignment="Center" Margin="0,1,6,0" />
                            <TextBlock Text="{l:Tr Support}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource DarkButton}" Click="OnSourceClick" Margin="6,0,0,0"
                            Content="{l:Tr SourceCode}" ToolTip="{l:Tr SourceCodeTip}" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource Small}" FontSize="11.5" Margin="10,0,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="20,16,20,4">
                <!-- Barras -->
                <TextBlock Style="{StaticResource Section}" Text="{l:Tr SectionBars}" />
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox DockPanel.Dock="Right" x:Name="MoveRegionsCheck" Style="{StaticResource Switch}" />
                            <TextBlock Style="{StaticResource Label}" ToolTip="{l:Tr MoveRegionsTip}" Text="{l:Tr MoveRegions}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource Divider}" />
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox DockPanel.Dock="Right" x:Name="EdgeFrameCheck" Style="{StaticResource Switch}" />
                            <TextBlock Style="{StaticResource Label}" ToolTip="{l:Tr EdgeFrameTip}" Text="{l:Tr EdgeFrame}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource Divider}" />
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox DockPanel.Dock="Right" x:Name="HoverPreviewCheck" Style="{StaticResource Switch}" />
                            <TextBlock Style="{StaticResource Label}" ToolTip="{l:Tr HoverPreviewTip}" Text="{l:Tr HoverPreview}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource Divider}" />
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox DockPanel.Dock="Right" x:Name="CachedLineCheck" Style="{StaticResource Switch}" />
                            <TextBlock Style="{StaticResource Label}" ToolTip="{l:Tr CachedLineTip}" Text="{l:Tr CachedLine}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource Divider}" />
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox DockPanel.Dock="Right" x:Name="MarksCheck" Style="{StaticResource Switch}" />
                            <TextBlock Style="{StaticResource Label}" ToolTip="{l:Tr MarksTip}" Text="{l:Tr Marks}" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Navegación -->
                <TextBlock Style="{StaticResource Section}" Text="{l:Tr SectionNavigation}" />
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox x:Name="SeekBox" Style="{StaticResource NumberBox}" />
                                <TextBlock Style="{StaticResource Small}" Text="{l:Tr SecondsUnit}" Margin="5,0,14,0" />
                                <TextBlock Style="{StaticResource Small}" Text="{l:Tr KeyShift}" Margin="0,0,6,0" />
                                <TextBox x:Name="SeekShiftBox" Style="{StaticResource NumberBox}" />
                                <TextBlock Style="{StaticResource Small}" Text="{l:Tr SecondsUnit}" Margin="5,0,14,0" />
                                <TextBlock Style="{StaticResource Small}" Text="{l:Tr KeyCtrl}" Margin="0,0,6,0" />
                                <TextBox x:Name="SeekCtrlBox" Style="{StaticResource NumberBox}" />
                                <TextBlock Style="{StaticResource Small}" Text="{l:Tr SecondsUnit}" Margin="5,0,0,0" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Label}" ToolTip="{l:Tr SeekTip}" Text="{l:Tr Seek}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource Divider}" />
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock DockPanel.Dock="Right" x:Name="ScrubText" Style="{StaticResource Small}" MinWidth="92" Margin="10,0,0,0" />
                            <Slider DockPanel.Dock="Right" x:Name="ScrubSlider" Style="{StaticResource DarkSlider}" Width="200" Minimum="1" Maximum="20" TickFrequency="1"
                                    IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" VerticalAlignment="Center" Focusable="False" />
                            <TextBlock Style="{StaticResource Label}" ToolTip="{l:Tr ScrubTip}" Text="{l:Tr Scrub}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource Divider}" />
                        <DockPanel Style="{StaticResource Row}">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton x:Name="WheelVolumeRadio" Style="{StaticResource Segment}" GroupName="Wheel" Content="{l:Tr WheelVolume}" />
                                <RadioButton x:Name="WheelSpeedRadio" Style="{StaticResource Segment}" GroupName="Wheel" Content="{l:Tr WheelSpeed}" Margin="4,0,0,0" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Label}" ToolTip="{l:Tr WheelTip}" Text="{l:Tr Wheel}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource Divider}" />
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox DockPanel.Dock="Right" x:Name="ResumeCheck" Style="{StaticResource Switch}" />
                            <TextBlock Style="{StaticResource Label}" Text="{l:Tr Resume}" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Tiempo y bookmarks -->
                <TextBlock Style="{StaticResource Section}" Text="{l:Tr SectionTimeAndBookmarks}" />
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton x:Name="TimeMsRadio" Style="{StaticResource Segment}" GroupName="Time" Content="01:23.456" />
                                <RadioButton x:Name="TimeFramesRadio" Style="{StaticResource Segment}" GroupName="Time" Content="00:01:23:11" Margin="4,0,0,0" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Label}" ToolTip="{l:Tr TimeFormatTip}" Text="{l:Tr TimeFormat}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource Divider}" />
                        <DockPanel Style="{StaticResource Row}">
                            <StackPanel DockPanel.Dock="Right" x:Name="ColorPanel" Orientation="Horizontal" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource Label}" ToolTip="{l:Tr NewColorTip}" Text="{l:Tr NewColor}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource Divider}" />
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox DockPanel.Dock="Right" x:Name="RepeatLabelCheck" Style="{StaticResource Switch}" />
                            <TextBlock Style="{StaticResource Label}" ToolTip="{l:Tr RepeatLabelTip}" Text="{l:Tr RepeatLabel}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource Divider}" />
                        <DockPanel Style="{StaticResource Row}">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton x:Name="TimesPreviewRadio" Style="{StaticResource Segment}" GroupName="BookmarkTimes" Content="{l:Tr TimesInPreview}" />
                                <RadioButton x:Name="TimesListRadio" Style="{StaticResource Segment}" GroupName="BookmarkTimes" Content="{l:Tr TimesInList}" Margin="4,0,0,0" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Label}" ToolTip="{l:Tr BookmarkTimesTip}" Text="{l:Tr BookmarkTimes}" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Audio y subtítulos -->
                <TextBlock Style="{StaticResource Section}" Text="{l:Tr SectionAudioAndSubtitles}" />
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <ComboBox DockPanel.Dock="Right" x:Name="AudioLangCombo" Style="{StaticResource DarkCombo}" />
                            <TextBlock Style="{StaticResource Label}" ToolTip="{l:Tr AudioLanguageTip}" Text="{l:Tr AudioLanguage}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource Divider}" />
                        <DockPanel Style="{StaticResource Row}">
                            <ComboBox DockPanel.Dock="Right" x:Name="SubLangCombo" Style="{StaticResource DarkCombo}" />
                            <TextBlock Style="{StaticResource Label}" ToolTip="{l:Tr SubtitleLanguageTip}" Text="{l:Tr SubtitleLanguage}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource Divider}" />
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox DockPanel.Dock="Right" x:Name="SubsOnOpenCheck" Style="{StaticResource Switch}" />
                            <TextBlock Style="{StaticResource Label}" ToolTip="{l:Tr AppliesOnNextVideo}" Text="{l:Tr SubtitlesOnOpen}" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Rendimiento -->
                <TextBlock Style="{StaticResource Section}" Text="{l:Tr SectionPerformance}" />
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock DockPanel.Dock="Right" x:Name="CacheText" Style="{StaticResource Small}" MinWidth="92" Margin="10,0,0,0" />
                            <Slider DockPanel.Dock="Right" x:Name="CacheSlider" Style="{StaticResource DarkSlider}" Width="200" Minimum="512" TickFrequency="256"
                                    IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" VerticalAlignment="Center" Focusable="False" />
                            <TextBlock x:Name="CacheLabel" Style="{StaticResource Label}" Text="{l:Tr CacheMemory}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource Divider}" />
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox DockPanel.Dock="Right" x:Name="HwdecCheck" Style="{StaticResource Switch}" />
                            <TextBlock Style="{StaticResource Label}" ToolTip="{l:Tr HardwareDecodingTip}" Text="{l:Tr HardwareDecoding}" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Clips (Ctrl + M) -->
                <TextBlock Style="{StaticResource Section}" Text="{l:Tr SectionClips}" />
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource DarkButton}" Content="{l:Tr ChangeEllipsis}" Click="OnChangeClipFolderClick" Margin="10,0,0,0" />
                                <Button x:Name="ClipFolderBesideButton" Style="{StaticResource DarkButton}" Content="{l:Tr BesideVideo}"
                                        Click="OnClipFolderBesideClick" Margin="6,0,0,0" />
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Label}" ToolTip="{l:Tr ClipFolderTip}" Text="{l:Tr ClipFolder}" />
                                <TextBlock x:Name="ClipFolderText" Style="{StaticResource Small}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                        <Rectangle Style="{StaticResource Divider}" />
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox DockPanel.Dock="Right" x:Name="ClipClipboardCheck" Style="{StaticResource Switch}" />
                            <TextBlock Style="{StaticResource Label}" ToolTip="{l:Tr ClipClipboardTip}" Text="{l:Tr ClipClipboard}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource Divider}" />
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock DockPanel.Dock="Right" x:Name="LightClipText" Style="{StaticResource Small}" MinWidth="92" Margin="10,0,0,0" />
                            <Slider DockPanel.Dock="Right" x:Name="LightClipSlider" Style="{StaticResource DarkSlider}" Width="200" Minimum="0.25" Maximum="4" TickFrequency="0.25"
                                    IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" VerticalAlignment="Center" Focusable="False" />
                            <TextBlock Style="{StaticResource Label}" ToolTip="{l:Tr LightClipTip}" Text="{l:Tr LightClip}" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- General -->
                <TextBlock Style="{StaticResource Section}" Text="{l:Tr SectionGeneral}" />
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <ComboBox DockPanel.Dock="Right" x:Name="UiLanguageCombo" Style="{StaticResource DarkCombo}" />
                            <TextBlock Style="{StaticResource Label}" ToolTip="{l:Tr InterfaceLanguageTip}" Text="{l:Tr InterfaceLanguage}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource Divider}" />
                        <DockPanel Style="{StaticResource Row}">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource DarkButton}" Content="{l:Tr Open}" Click="OnOpenDataFolderClick" Margin="10,0,0,0" />
                                <Button Style="{StaticResource DarkButton}" Content="{l:Tr ChangeEllipsis}" Click="OnChangeDataFolderClick" Margin="6,0,0,0" />
                                <Button x:Name="DefaultFolderButton" Style="{StaticResource DarkButton}" Content="{l:Tr DefaultFolder}"
                                        Click="OnDefaultDataFolderClick" Margin="6,0,0,0"
                                        ToolTip="{l:Tr DefaultFolderTip}" />
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Label}" ToolTip="{l:Tr DataFolderTip}" Text="{l:Tr DataFolder}" />
                                <TextBlock x:Name="DataFolderText" Style="{StaticResource Small}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock x:Name="PendingFolderText" Foreground="{StaticResource Accent}" FontSize="12" TextWrapping="Wrap"
                                   Margin="0,0,0,8" Visibility="Collapsed" />
                        <Rectangle Style="{StaticResource Divider}" />
                        <DockPanel Style="{StaticResource Row}">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource DarkButton}" Content="{l:Tr ChooseInWindows}" Click="OnChooseInWindowsClick" Margin="10,0,0,0" />
                                <Button x:Name="UnregisterButton" Style="{StaticResource DarkButton}" Content="{l:Tr Unregister}" Click="OnUnregisterClick" Margin="6,0,0,0" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Label}" Text="{l:Tr DefaultPlayer}"
                                       ToolTip="{l:Tr DefaultPlayerTip}" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
